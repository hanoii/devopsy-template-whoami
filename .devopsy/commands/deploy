#!/bin/sh
## Description: Roll out (run on the server by release)
# The environments' release and rollback run step (config.yaml), run on the
# server by `devopsy @<target> --release` and `--rollback`. devopsy pulled
# the image before the release went live (image mode).
set -eu
devopsy up -d --wait --remove-orphans
echo "deploy: ${SITE_URL:-no URL: no base domain or PROXY_DOMAINS}" >&2
